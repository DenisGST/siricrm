# Local settings / secrets
# 🛑 Игнорируем ВСЕ .env* — любой новый .env.<что-угодно> (.env.fornex и т.п.)
# считается секретом по умолчанию. Раньше перечислялись только .env/.env.prod/
# .env.dev/.env.*.local, и файл с другим суффиксом мог уехать в публичный репо
# первым же `git add -A`. Исключение — шаблоны без секретов, они коммитятся.
.env*
!.env.*.example
*.local.py
settings_local.py
*.session*

# Backups
backups/
*.sql
*.sql.gz

# IDE / Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Migrations cache (опционально, если не хочешь трекать pycache)
**/migrations/__pycache__/

# Node / front (если вдруг появится)
node_modules/
npm-debug.log*
yarn-error.log*

# Docker
docker-compose.override.yml
*.pid

#css
tailwindcssuserbot_session.session
*.session
tailwindcss
logs/userbot.log

# Claude Code — settings.json коммитим (общие для всех машин), остальное локальное
.claude/*
!.claude/settings.json
